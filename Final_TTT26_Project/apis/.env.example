# Backend (api.py) — copy to `.env` (gitignored). `api.py` loads `.env` via python-dotenv.
#
# International map search: OpenCage is tried before Nominatim when the map is outside India.
# https://opencagedata.com/api
OPENCAGE_API_KEY=

# Map search bar: Google Places Autocomplete + Place Details (server-side).
# There is no shared “free” key in the repo — create your own in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis
# Enable “Places API” (legacy web service). New accounts often get trial / monthly credits;
# see https://mapsplatform.google.com/pricing/
#
# If unset, falls back to GOOGLE_PLACES_API_KEY (same key can power competitors + search).
GOOGLE_MAPS_SEARCH_API_KEY=

# Competitors via Google Places Nearby Search (optional; also used for map search if GOOGLE_MAPS_SEARCH_API_KEY is empty)
GOOGLE_PLACES_API_KEY=
